# 复制本文件为 .env 或 .env.local（不要提交到 Git）
# Docker Compose 会读取当前目录下的 .env 中的变量

# 可选：AI 对话 /api/ai/chat（二选一或只配其一；同时配置时优先 OpenAI 兼容）
# OpenAI 官方或兼容接口（密钥多为 sk- 开头）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini（密钥多为 AIza… 开头，与 @google/genai 配合）
GEMINI_API_KEY=

# 可选：容器映射到宿主机端口（与 docker-compose.yml 中 HOST_PORT 对应）
HOST_PORT=3000
