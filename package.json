{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "scrape:college-hot": "tsx server/scrapeCollegeHot.ts",
    "scrape:college-dynamics": "tsx server/scrapeCollegeDynamics.ts",
    "scrape:college-headline-slides": "tsx server/scrapeCollegeHeadlineSlides.ts",
    "scrape:college-dynamics:refresh": "tsx server/refreshCollegeDynamicsData.ts",
    "scrape:renderable:refresh": "tsx server/refreshRenderableArticles.ts",
    "scrape:images:article-only": "tsx server/rebuildArticleImagesOnly.ts",
    "scrape:college-full": "tsx server/scrapeCollegeFullArticles.ts",
    "scrape:legal-exam-articles": "tsx server/scrapeLegalExamArticles.ts",
    "scrape:legal-exam-questions": "tsx server/scrapeLegalExamQuestions.ts",
    "sync:legal-exam-json": "tsx scripts/syncLegalExamJson.ts",
    "build:court-3d": "powershell -ExecutionPolicy Bypass -File scripts/build-court-3d.ps1",
    "patch:court-3d": "node scripts/patch-court-3d-index.cjs && node scripts/patch-court-3d-framework-orientation.cjs",
    "scrape:legal-videos": "tsx scripts/scrapeLegalVideos.ts",
    "export:legal-ai-doc": "tsx scripts/exportLegalAiDoc.ts",
    "export:legal-ai-word": "tsx scripts/exportLegalAiDoc.ts && python scripts/md_to_docx.py"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.15.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "firebase": "^12.12.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
